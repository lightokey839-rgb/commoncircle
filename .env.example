# CommonCircle configuration (NEAR testnet). Copy to .env locally; never commit a filled-in copy.
# Never put a private key, seed phrase or wallet password in any of these files.

# ---- Web app (Vite, build time; values become public in the page) ----
# The hosted chat / sign-in server (server/auth.ts). Empty = chat shows as offline on a public copy.
VITE_AUTH_URL=http://localhost:3001
# GitHub Pages serves the app under /commoncircle/; a root domain uses /.
VITE_BASE_PATH=/

# ---- Chat / sign-in server (server/auth.ts) ----
# development (default): JSON files in server/.data, one process only.
# production: requires DATABASE_URL, AUTH_JWT_SECRET, APP_ORIGINS, NEAR_AUTH_RECIPIENTS.
COMMONCIRCLE_ENV=development
PORT=3001
# HOST defaults to 127.0.0.1 in development and 0.0.0.0 in production.
HOST=
# PostgreSQL (required in production). Schema: server/migrations/*.sql, applied on start.
DATABASE_URL=
DATABASE_SSL=
# Session signing secret, at least 32 characters (openssl rand -hex 32). Server only, never VITE_.
AUTH_JWT_SECRET=
AUTH_SESSION_TTL_SEC=43200
# Browser origins allowed to call the server, comma separated (https only in production).
APP_ORIGINS=https://lightokey839-rgb.github.io
# Hosts the wallet shows as the NEP-413 recipient (defaults to the hosts of APP_ORIGINS).
NEAR_AUTH_RECIPIENTS=lightokey839-rgb.github.io
# Behind a proxy/load balancer (Render, Fly…): rate limits use X-Forwarded-For.
AUTH_TRUST_PROXY=0
NEAR_RPC_URL=https://test.rpc.fastnear.com
CIRCLE_CONTRACT_ID=commoncircle-light.testnet

# ---- Read-only verification scripts (scripts/verify-usdc.mjs, claims) ----
NEAR_TESTNET_RPC_URL=
USDC_TESTNET_ID=
